# Secrets
.env
.env.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# macOS
.DS_Store

# Source PDFs for FY2015-26 are large and re-downloadable from
# https://www.belvidereil.gov/budget/ and https://www.belvidereil.gov/audit/
sources/*/budgets/
sources/*/audits/

# OCR scratch output (regenerable)
data/*/ocr/

# Site data generated by govbudget.export_site (CI builds it; not committed)
web/public/data/
web/node_modules/
web/dist/
web/.astro/

# Park district source PDFs (re-downloadable with pipelines/belvidere_park_district/fetch_sources.py)
sources/*/ordinances/
sources/*/treasurers/
