---
import { readData, href } from '../lib/data';
// `entity` and `section` switch on the government's navigation; section is the id of the page being shown
const { title, description = '', entity = '', section = '' } = Astro.props;
const meta = entity ? readData(entity, 'meta.json') : null;
const has = (d: string) => !!meta?.datasets.includes(d);
const nav = entity ? [
  { id: 'overview', label: 'Overview', path: `/${entity}/`, show: true },
  { id: 'taxes', label: 'Taxes', path: `/${entity}/taxes/`, show: has('taxes_by_category') },
  { id: 'expenses', label: 'Expenses', path: `/${entity}/expenses/`, show: has('expenses_by_dept_object') },
  { id: 'audit', label: 'Audit vs budget', path: `/${entity}/expenses/audit/`, show: has('expenses_audit_vs_budget') },
  { id: 'water-sewer', label: 'Water/Sewer', path: `/${entity}/water-sewer/`, show: has('ws_summary') },
  { id: 'other-funds', label: 'Other funds', path: `/${entity}/other-funds/`, show: has('other_funds') },
  { id: 'pensions', label: 'Pensions', path: `/${entity}/pensions/`, show: has('pension_plans') },
  { id: 'debt', label: 'Debt', path: `/${entity}/debt/`, show: has('debt_balances') },
  { id: 'fund-balance', label: 'Fund balance', path: `/${entity}/fund-balance/`, show: has('fund_balance') },
  { id: 'revenue', label: 'Revenue', path: `/${entity}/revenue/`, show: has('park_revenue') },
  { id: 'spending', label: 'Spending', path: `/${entity}/spending/`, show: has('park_spending') },
  { id: 'levy', label: 'Property tax levy', path: `/${entity}/levy/`, show: has('levies') },
  { id: 'audit-budget', label: 'Audit vs budget', path: `/${entity}/audit-budget/`, show: has('park_audit_vs_budget') },
  { id: 'fund-balances', label: 'Fund balances', path: `/${entity}/fund-balances/`, show: has('park_fund_balance') },
  { id: 'liabilities', label: 'Debt', path: `/${entity}/liabilities/`, show: has('park_debt') },
].filter((n) => n.show) : [];
const palette = readData<Record<string, string>>('palette.json');
const vars = Object.entries(palette).map(([k, v]) => `--${k.replace(/_/g, '-')}: ${v};`).join(' ');
---
<!doctype html>
<html lang="en" style={vars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <header>
      <a class="brand" href={href('/')}>Local government budgets</a>
      {meta && <span class="entity"><a href={href(`/${entity}/`)}>{meta.short_name}</a></span>}
      {nav.length > 0 && (
        <nav aria-label={`${meta.short_name} pages`}>
          {nav.map((n) => <a href={href(n.path)} aria-current={n.id === section ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      )}
    </header>
    <main><slot /></main>
    <footer>
      <p>Open source (Apache-2.0). Every number is extracted from the government's own budgets, ordinances and audits and validated against the totals they print.</p>
    </footer>
  </body>
</html>
<style is:global>
  :root { color-scheme: light; }
  body { overflow-wrap: break-word; margin: 0; background: var(--surface); color: var(--ink); font: 16px/1.5 system-ui, sans-serif; }
  header, main, footer { max-width: 60rem; margin: 0 auto; padding: 0 16px; }
  header { padding-top: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--rule); }
  header { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 16px; }
  .brand { font-weight: 700; color: var(--ink); text-decoration: none; }
  .entity a { color: var(--ink2); text-decoration: none; }
  header nav { display: flex; flex-wrap: wrap; gap: 4px 14px; flex-basis: 100%; font-size: 0.9375rem; padding-top: 6px; }
  header nav a { color: var(--ink2); text-decoration: none; padding-bottom: 2px; border-bottom: 2px solid transparent; }
  header nav a:hover { color: var(--ink); }
  header nav a[aria-current='page'] { color: var(--ink); font-weight: 600; border-bottom-color: var(--up); }
  main { padding-top: 24px; padding-bottom: 32px; }
  footer { color: var(--ink2); font-size: 0.875rem; padding-bottom: 24px; }
  a { color: var(--up); }
  table { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; }
  th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--grid); }
  th { background: var(--panel); color: var(--ink2); font-weight: 600; font-size: 0.875rem; }
  td.num, th.num { text-align: right; }
  .muted { color: var(--ink2); }
</style>
