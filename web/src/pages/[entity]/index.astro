---
import Base from '../../layouts/Base.astro';
import { readData, href } from '../../lib/data';

export function getStaticPaths() {
  const { entities } = readData('index.json');
  return entities.map((e: any) => ({ params: { entity: e.entity_id } }));
}
const entity = '' + Astro.params.entity;
const meta = readData(entity, 'meta.json');
const datasets = meta.datasets.map((name: string) => {
  const d = readData(entity, `${name}.json`);
  return { name, title: d.title, description: d.description, rows: d.rows.length };
});
const refSources: any[] = meta.datasets.includes('reference_sources') ? readData(entity, 'reference_sources.json').rows : [];
const exceptions = readData(entity, 'exceptions.json').exceptions.length;
const taxYears = meta.datasets.includes('tax_lines')
  ? ([...new Set(readData(entity, 'tax_lines.json').rows.filter((r: any) => r.measure === 'budget_adopted').map((r: any) => r.fiscal_year))] as number[]).sort().reverse()
  : [];
const { budget_range, audit_range } = meta.documents;
---
<Base entity={entity} section="overview" title={`${meta.short_name} budget data`} description={`Budget and audit data for ${meta.name}.`}>
  <h1>{meta.name}</h1>
  <p class="muted">{meta.fy_label_rule.charAt(0).toUpperCase() + meta.fy_label_rule.slice(1)}. Documents: budgets FY{budget_range[0]}–FY{budget_range[1]}, audits FY{audit_range[0]}–FY{audit_range[1]}.</p>
  <h2>Pages</h2>
  <ul>
    {taxYears.length > 0 && <li><a href={href(`/${entity}/taxes/`)}>General Fund taxes over time</a>: composition, offsets, budget vs audited actual</li>}
    {meta.datasets.includes('expenses_by_dept_object') && <li><a href={href(`/${entity}/expenses/`)}>General Fund expenses over time</a>: by department group, object category and department</li>}
    {meta.datasets.includes('ws_summary') && <li><a href={href(`/${entity}/water-sewer/`)}>Water and Sewer Fund</a>: net position, operating results, cash, audited spending vs budget</li>}
    {meta.datasets.includes('other_funds') && <li><a href={href(`/${entity}/other-funds/`)}>Other funds</a>: Motor Fuel Tax, TIFs, special service areas, Capital Projects, library, pensions</li>}
    {meta.datasets.includes('debt_balances') && <li><a href={href(`/${entity}/debt/`)}>Debt and long-term liabilities</a>: borrowing, pensions, retiree health, scheduled payments</li>}
    {meta.datasets.includes('pension_plans') && <li><a href={href(`/${entity}/pensions/`)}>Pensions and retiree health</a>: funded ratios, contributions, retiree health liability</li>}
    {meta.datasets.includes('expenses_audit_vs_budget') && <li><a href={href(`/${entity}/expenses/audit/`)}>Audited spending vs the budget</a>: total and by department group</li>}
    {meta.datasets.includes('fund_balance') && <li><a href={href(`/${entity}/fund-balance/`)}>General Fund balance and reserves</a>: balance by category, months of spending in reserve, revenues and spending</li>}
    {taxYears.length > 0 && <li>General Fund taxes by year, as adopted: {taxYears.map((y: number, i: number) => <><a href={href(`/${entity}/taxes/${y}/`)}>FY{y}</a>{i < taxYears.length - 1 ? ', ' : ''}</>)}</li>}
  </ul>
  <h2>Datasets available</h2>
  <table>
    <thead><tr><th>Dataset (JSON)</th><th>What it holds</th><th class="num">Rows</th></tr></thead>
    <tbody>
      {datasets.map((d: any) => (
        <tr><td><a href={href(`/data/${entity}/${d.name}.json`)}>{d.title}</a></td><td>{d.description}</td><td class="num">{d.rows.toLocaleString('en-US')}</td></tr>
      ))}
    </tbody>
  </table>
  <p>{exceptions} recorded exceptions (places where the source documents are inconsistent or do not fit the shared model) are published with the data.</p>
  <p><a href={href(`/data/${entity}/downloads/facts.csv.gz`)}>Download every extracted line (facts.csv.gz)</a></p>
  {refSources.length > 0 && (<>
    <h2>Reference data</h2>
    <p class="muted">The “per resident” and “adjusted for inflation” views use these public series. Each is a small table by fiscal year in the downloads.</p>
    <ul>{refSources.map((r: any) => <li><strong>{r.description}</strong>. {r.publisher}, <a href={r.url}>{r.identifier}</a>; retrieved {r.retrieved_on}. <span class="muted">{r.method}</span></li>)}</ul>
  </>)}
</Base>
